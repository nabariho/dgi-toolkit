# DGI Toolkit Environment Variables

# Data Configuration
DGI_DATA_PATH=data/fundamentals_small.csv

# Logging Configuration
DGI_LOG_LEVEL=INFO

# Default Filter Settings
DGI_MIN_YIELD=0.02
DGI_MAX_PAYOUT=80.0
DGI_MIN_CAGR=0.05
DGI_TOP_N=10

# Default Screen Settings (for internal functions)
DGI_SCREEN_MIN_YIELD=0.0
DGI_SCREEN_MAX_PAYOUT=100.0
DGI_SCREEN_MIN_CAGR=0.0

# LLM Provider Configuration (optional)
DGI_LLM_PROVIDER=openai
DGI_LLM_MODEL=gpt-4o-mini

# API Keys (required for AI features)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# API Configuration (DGI_API_ prefix)
DGI_API_DEBUG=false
DGI_API_HOST=0.0.0.0
DGI_API_PORT=8000
DGI_API_RELOAD=true

# API Rate Limiting
DGI_API_RATE_LIMIT_REQUESTS=100
DGI_API_RATE_LIMIT_PERIOD=60

# API CORS Settings
DGI_API_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
DGI_API_CORS_ALLOW_CREDENTIALS=true
DGI_API_CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
DGI_API_CORS_ALLOW_HEADERS=["*"]

# API Logging
DGI_API_LOG_LEVEL=INFO
DGI_API_LOG_FORMAT=json

# API Security
DGI_API_ENABLE_SECURITY_HEADERS=true
DGI_API_ENABLE_RATE_LIMITING=true

# API Validation Limits
DGI_API_MAX_TOP_N=100

# Scoring Configuration
DGI_YIELD_WEIGHT=1.0
DGI_GROWTH_WEIGHT=0.5
DGI_PAYOUT_PENALTY_WEIGHT=-0.1
DGI_PAYOUT_PENALTY_THRESHOLD=60.0
DGI_FCF_YIELD_WEIGHT=0.3
DGI_SECTOR_BONUS=0.1
DGI_INDUSTRY_BONUS=0.05

# Scoring Thresholds
DGI_MIN_TOTAL_SCORE=0.0
DGI_MAX_TOTAL_SCORE=100.0
DGI_SCORE_NORMALIZATION_FACTOR=1.0

# Preferred Sectors and Industries (comma-separated)
DGI_PREFERRED_SECTORS=Consumer Defensive,Healthcare,Utilities,Real Estate,Consumer Cyclical
DGI_PREFERRED_INDUSTRIES=Drug Manufacturers,Utilities - Regulated Electric,REIT - Retail,REIT - Office,Beverages - Non-Alcoholic
DGI_PENALTY_SECTORS=Energy,Basic Materials
DGI_PENALTY_INDUSTRIES=Oil & Gas E&P,Oil & Gas Integrated,Oil & Gas Midstream

# API Caching Configuration
DGI_API_CACHE_DEFAULT_TTL=300
DGI_API_CACHE_MAX_SIZE=1000

# API Async Processing Configuration
DGI_API_MAX_CONCURRENT_JOBS=3
DGI_API_JOB_TIMEOUT_SECONDS=300

# API File Processing Configuration
DGI_API_MAX_FILE_SIZE_MB=50
DGI_API_ALLOWED_FILE_EXTENSIONS=[".csv"]
