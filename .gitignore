# Python
__pycache__/
*.py[cod]
*$py.class

# Poetry
.poetry/
.venv/
# poetry.lock should be tracked
# Remove from ignore list if present
poetry.lock

# Jupyter Notebooks
notebooks/.ipynb_checkpoints/
*.ipynb_checkpoints

# Test and coverage
.coverage
htmlcov/
.tox/
.pytest_cache/
tests/

# Misc
.DS_Store
*.log
*.tmp
.cache/
.env
*.db
*.sqlite3
*.egg-info/
.eggs/

# Large files
*.csv
*.csv.*

# Tests
!tests/
!tests/*.py
tests/__pycache__/

# Allow data directory and its CSV files
!data/
!data/*.csv

# Test data
tests/test_data/
*.test.csv
*.test.json
*.test.db

# Environment files
.env
.env.local
.env.test
